    characterSequence: "\u6D51\u5929\u4EEA\r\n\u5B50\u5348\u73AF\uFF0C\u56FA\u5B9A\u5728\u5357\u5317\u65B9\u5411\r\n\u53D6\u5317\u6781\u53CA\u8861\uFF0C\u5404\u9488\u7A7F\u4E4B\u4E3A\u8F74\r\n\u8D64\u9053\u73AF\uFF1A\u5E73\u884C\u4E8E\u5730\u7403\u8D64\u9053\u9762\r\n\u53D6\u8584\u7AF9\u7BFE\u7A7F\u5176\u4E24\u7AEF\uFF0C\u4EE4\u4E24\u7A7F\u4E2D\u95F4\u4E0E\u6D51\u534A\u7B49\u4EE5\u8D2F\u4E4B\uFF0C\u4EE4\u5BDF\u4E4B\u4E0E\u6D51\u76F8\u5207\u6469\r\n\u8D64\u7ECF\u73AF\uFF1A\u8D64\u7ECF\u73AF\u4E0E\u91D1\u5C5E\u8F74\u76F8\u4EA4\u4E8E\u4E24\u70B9\uFF0C\u4E00\u70B9\u6307\u5411\u5317\u5929\u6781\uFF0C\u53E6\u4E00\u70B9\u6307\u5411\u5357\u5929\u6781\u3002\u5728\u8D64\u7ECF\u73AF\u9762\u4E0A\u88C5\u7740\u4E00\u6839\u671B\u7B52\uFF0C\u53EF\u4EE5\u7ED5\u8D64\u7ECF\u73AF\u4E2D\u5FC3\u8F6C\u52A8\uFF0C\u7528\u671B\u7B52\u5BF9\u51C6\u67D0\u9897\u661F\u661F\r\n\u53C8\u4E2D\u5206\u5176\u7BFE\uFF0C\u62D7\u53BB\u5176\u534A\uFF0C\u4EE4\u5176\u534A\u4E4B\u9645\uFF0C\u6B63\u76F4\u4E0E\u4E24\u7AEF\u51CF\u534A\u76F8\u76F4\uFF0C\u4EE4\u7BFE\u534A\u4E4B\u9645\uFF0C\u4ECE\u51AC\u81F3\u8D77\u4E00\u5EA6\u4E00\u79FB\u4E4B\uFF0C\u89C6\u7BFE\u4E4B\u534A\u9645\u591A\u5C11\uFF0C\u9EC4\u8D64\u9053\u51E0\u4E5F\r\n\u7AA5\u7BA1\uFF1A\u671B\u7B52\u901A\u8FC7\u8D64\u7ECF\u73AF\uFF08\u56DB\u6E38\u73AF\uFF09\u4E0E\u8D64\u9053\u73AF\u7684\u8054\u52A8\uFF0C\u5B9E\u73B0\u5929\u4F53\u8D64\u7EAC\uFF08\u53BB\u6781\u5EA6\uFF09\u548C\u8D64\u7ECF\uFF08\u5165\u5BBF\u5EA6\uFF09\u7684\u7CBE\u786E\u6D4B\u91CF\r\n\u201C\u4E24\u6781\u5185\u7F6E\u76F4\u8DDD\uFF0C\u76F4\u8DDD\u5939\u671B\u7B52\uFF0C\u4F7F\u5357\u5317\u4F4E\u6602\uFF0C\u65CB\u8F6C\u6301\u6B63\uFF0C\u7AA5\u6D4B\u4E03\u66DC\uFF0C\u7686\u4F9D\u5FAA\u884C\u4E4B\u6CD5\u3002\u201D\r\n\u572D\u8868 
      \u201C\u5468\u9AC0\u957F\u516B\u5C3A\uFF0C\u590F\u81F3\u4E4B\u65E5\u6677\u4E00\u5C3A\u516D\u5BF8\u3002\u201D\r\n\u201C\u572D\u957F\u5C3A\u6709\u4E8C\u5BF8\uFF0C\u5261\u4E0A\uFF0C\u5BF8\u534A\u3002\u201D\r\n\u201C\u51AC\u81F3\u4E4B\u65E5\u6677\u4E00\u4E08\u4E09\u5C3A\u4E94\u5BF8\uFF0C\u590F\u81F3\u4E4B\u65E5\u6677\u4E00\u5C3A\u516D\u5BF8\u201D\r\n\u201C\u572D\u957F\u5C3A\u6709\u4E8C\u5BF8\uFF0C\u5261\u4E0A\uFF0C\u5BF8\u534A\u3002\u201D\r\n\u201C\u4EE5\u571F\u572D\u4E4B\u6CD5\u6D4B\u571F\u6DF1\uFF0C\u6B63\u65E5\u5F71\uFF0C\u4EE5\u6C42\u5730\u4E2D\u3002\u201D\r\n\u6C49\u671D\uFF1A\u6D51\u5929\u4EEA\"\u4E00\u8F74\u8F6C\u4E7E\u5764\u4E07\u8C61\uFF0C\u4E5D\u6CC9\u6D41\u663C\u591C\u5343\u5E74\"\r\n\u5929\u6587\u53E4\u4EE3\u4EEA\u5668\r\n\u4E8C\u3001\u7ED3\u6784\u4E0E\u8BBE\u8BA1\r\n\u7391\u8861\u629A\u8FB0\u4EEA\u5206\u4E3A\u4E09\u5C42\uFF0C\u878D\u5408\u4F20\u7EDF\u6D51\u4EEA\u4E0E\u897F\u65B9\u523B\u5EA6\u4F53\u7CFB\uFF0C\u7ED3\u6784\u7CBE\u5BC6\uFF1A\r\n1.
      \u200B\u5916\u5C42\uFF08\u516D\u5408\u4EEA\uFF09\u200B\r\n\u2022 \u200B\u5B50\u5348\u53CC\u5708\uFF1A\u5357\u5317\u6B63\u7ACB\u7684\u94DC\u73AF\uFF0C\u56FA\u5B9A\u4E8E\u4E91\u5EA7\u4E0A\uFF0C\u7A7A\u9699\u4E2D\u7EBF\u4E3A\u5B50\u5348\u7EBF\uFF0C\u523B\u6709\u53BB\u6781\u5EA6\uFF0C\u5317\u6781\u9AD8\u5EA6\u6309\u5317\u4EAC\u7EAC\u5EA6\u8BBE\u5B9A146\u3002\r\n\u2022
      \u200B\u5929\u5E38\u8D64\u9053\u5708\uFF1A\u5E73\u884C\u4E8E\u5929\u8D64\u9053\u7684\u56FA\u5B9A\u73AF\uFF0C\u4E24\u9762\u523B\u5468\u65E5\u65F6\u523B\uFF0C\u7528\u4E8E\u8BA1\u65F616\u3002\r\n2.
      \u200B\u4E2D\u5C42\uFF08\u4E09\u8FB0\u4EEA\uFF09\u200B \u201C\u6D51\u5929\u843D\u4E0B\u6C49\u6668\u66E6\uFF0C\u8881\u674E\u58F0\u540D\u4FE1\u6709\u65AF\u201D\u201C\u5949\u82E5\u94A6\u7EF4\u663E\uFF0C\u7814\u51E0\u51DB\u66F0\u660E\u3002\u7476\u67A2\u8C03\u5F8B\u7EAA\uFF0C\u73E0\u8D2F\u9A8C\u5929\u884C\u201D\r\n\u2022
      \u200B\u6E38\u65CB\u8D64\u9053\u5708\uFF1A\u53EF\u6CBF\u8D64\u9053\u9762\u79FB\u52A8\u7684\u73AF\uFF0C\u4E0E\u8D64\u6781\u7ECF\u5708\u76F8\u8FDE\uFF0C\u523B\u6709\u5468\u5929\u5EA6\u6570\uFF08360\xB0\uFF09\uFF0C\u7528\u4E8E\u6D4B\u91CF\u8D64\u7ECF146\u3002\r\n3.
      \u200B\u5185\u5C42\uFF08\u56DB\u6E38\u73AF\uFF09\u201C\u7391\u8861\u629A\u661F\u8FB0\uFF0C\u5386\u6DFB\u65B0\u5C81\u6708\u3002\u4E7E\u5764\u6C14\u8C61\u548C\uFF0C\u5171\u8BF4\u6B64\u5E74\u4E30\u201D\u201C\u5B99\u5408\u51DD\u6E05\u548C\uFF0C\u7199\u79EF\u5E86\u54B8\u7406\u3002\u629A\u8FB0\u656C\u6388\u65F6\uFF0C\u9521\u798F\u88AB\u5EB6\u58EB\u201D\r\n\u2022
      \u200B\u8D64\u7ECF\u5708\uFF1A\u53CC\u5C42\u94DC\u73AF\uFF0C\u4E2D\u5FC3\u6709\u7A7A\u5FC3\u94DC\u8F74\uFF0C\u5185\u7F6E\u7AA5\u7BA1\uFF0C\u524D\u7AEF\u5E26\u5341\u5B57\u4E1D\uFF0C\u53EF\u7CBE\u786E\u5BF9\u51C6\u5929\u4F53146\u3002\u4E0B\r\n
      \u201C\u94DC\u9F99\u8854\u66B4\u6D4B\u7384\u9EC4\uFF0C\u4E8C\u5341\u516B\u5BBF\u8F6C\u56DE\u5ECA\u201D\r\n\u2022
      \u200B\u7AA5\u8861\uFF1A\u8FDE\u63A5\u8D64\u7ECF\u5708\u7684\u76F4\u8DDD\uFF0C\u957F4.72\u5C3A\uFF0C\u7528\u4E8E\u89C2\u6D4B\u65F6\u56FA\u5B9A\u76EE\u680716\r\n\u4E09\u91CD\u73AF\u7EC4\u201C\u7518\u516C\u9020\u572D\u8868\uFF0C\u7ACB\u516B\u5C3A\u4E4B\u6728\uFF0C\u5782\u4E8C\u4E08\u4E4B\u7EF3\uFF0C\u5206\u5468\u5929\u4E3A\u4E09\u767E\u516D\u5341\u4E94\u5EA6\u56DB\u5206\u5EA6\u4E4B\u4E00
      \u201C\u91D1\u4EEA\u6D4B\u9707\u542F\u6D51\u832B\uFF0C\u5341\u8F7D\u6587\u6210\u53CC\u74A7\u5149\u201D\r\n\u300A\u56FD\u5B9D\u6863\u6848\u300B\u63CF\u8FF0\u5176\u6784\u9020\uFF1A\r\n\u200B\u200B\u201C\u5916\u5C42\u4E3A\u516D\u5408\u4EEA\uFF08\u5B50\u5348\u53CC\u5708\uFF09\uFF0C\u4E2D\u5C42\u4E3A\u4E09\u8FB0\u4EEA\uFF08\u6E38\u65CB\u8D64\u9053\u5708\uFF09\uFF0C\u5185\u5C42\u4E3A\u56DB\u6E38\u73AF\uFF08\u8D64\u7ECF\u5708\uFF09\uFF0C\u8D2F\u4EE5\u7AA5\u7BA1\uFF0C\u7AEF\u6709\u5341\u5B57\u4E1D\u3002\u201D\u200B\r\n\u5168\u4EEA\u820D\u5F03\u4F20\u7EDF\u5730\u5E73\u5708\u3001\u9EC4\u9053\u5708\uFF0C\u4EC5\u5B58\u8D64\u9053\u7CFB\u7EDF\uFF0C\u7B80\u5316\u7ED3\u6784\u800C\u6269\u5927\u89C2\u6D4B\u8303\u56F4\r\n\u200B\u5DE5\u827A\u7EC6\u8282\"\u67A2\u8F6E\u8F6C\u5904\u661F\u8FB0\u52A8\uFF0C\u6D51\u8C61\u79FB\u65F6\u5C81\u6708\u66F4\"\r\n\u300A\u5B88\u656C\u8BFE\u5802\u300B\u8F7D\u5176\u94F8\u9020\u5DE5\u827A\uFF1A\r\n\u200B\u200B\u201C\u4EEA\u91CD5145\u5343\u514B\uFF0C\u9AD83.379\u7C73\uFF0C\u9752\u94DC\u94F8\u9020\uFF0C\u6E38\u9F99\u7EB9\u9970\u6829\u6829\u5982\u751F\uFF0C\u4E91\u5EA7\u6258\u4E3E\u4E09\u91CD\u73AF\u7EC4\u3002\u201D\u200B\r\n\u9F99\u67F1\u3001\u7965\u4E91\u96D5\u523B\u8C61\u5F81\u7687\u6743\u4E0E\u5929\u8C61\u5173\u8054\uFF0C\u517C\u5177\u79D1\u5B66\u6027\u4E0E\u827A\u672F\u6027\r\n\u6C49\u671D\uFF0C\u6218\u56FD\uFF0C\u660E\u671D\uFF0C\u5143\u671D\uFF0C\u6E05\u671D\uFF0C\u5B8B\u671D\r\n\u70B9\u51FB\u5207\u6362\u6A21\u5F0F\r\n\u6C34\u4EEA\u8FD0\u8C61\u53F0
      \u6D41\u661F \u5F57\u661F\r\n\u70B9\u51FB\u8FDB\u5165\u573A\u666F\r\n\u573A\u666F\u9009\u62E9\r\n\u5317\u6597\u4E03\u661F\u548C\u5317\u6781\u661F\r\n\u661F\u4E91\r\n\u592A\u9633\u65B0\u53D1\u73B0\r\n\u6728\u661F\u536B\u661F\u4E0B\u5C42\uFF1A\u52A8\u529B\u88C5\u7F6E\u548C\u62A5\u65F6\u7CFB\u7EDF\r\n\u5F00\u542F\r\n--\u300A\u5468\u793C\xB7\u6625\u5B98\xB7\u5178\u745E\u300B\u8868\uFF1A\r\n\u201C\u5468\u9AC0\u957F\u516B\u5C3A\uFF0C\u9AC0\u8005\uFF0C\u80A1\u4E5F\uFF0C\u8868\u4E5F\u201D--\u300A\u5468\u9AC0\u7B97\u7ECF\u300B\r\nw\u5929\u5E38\u8D64\u9053\u5708\uFF1A\r\n\u201C\u5929\u5E38\u8D64\u9053\u5708\u4E24\u9762\u523B\u5468\u65E5\u65F6\u523B\uFF0C\u5916\u89C4\u9762\u5206\u4E09\u767E\u516D\u5341\u5EA6\u3002\u201D--\u300A\u5377\u4E8C\u5341\u4E03
      \u5FD7\u4E8C\u300B\u56DB\u6E38\u5708\uFF1A\r\n\u201C\u53F3\u56DB\u6E38\u4EEA\u53CC\u73AF\u3002\u76F4\u5F84\u516D\u5C3A\uFF0C\u9614\u4E00\u5BF8\u4E03\u5206\uFF0C\u4E24\u65C1\u5916\u5507\u539A\u516D\u5206\u534A\uFF0C\u5185\u5507\u534A\u9690\u8D77\u4E8C\u5206\uFF0C\u5171\u539A\u516B\u5206\u534A\u201D
      --\u300A\u65B0\u4EEA\u8C61\u6CD5\u8981\u300B\u5B50\u5348\u53CC\u5708\uFF1A\r\n\u201C\u6B63\u7ACB\u53CC\u73AF\u4E3A\u5B50\u5348\u5708\uFF0C\u4E24\u9762\u7686\u523B\u5468\u5929\u4E09\u767E\u516D\u5341\u5EA6\uFF0C\u81EA\u5357\u5317\u6781\u8D77\uFF0C\u521D\u5EA6\u81F3\u4E2D\u8981\u4E5D\u5341\u5EA6\uFF0C\u662F\u4E3A\u5929\u7ECF\u3002\u201D--\u300A\u94A6\u5B9A\u4EEA\u8C61\u8003\u6210\u300B\u572D\u8868\uFF1A\r\n
      \u201C\u663C\u53C2\u8BF8\u65E5\u4E2D\u4E4B\u666F\uFF0C\u591C\u8003\u4E4B\u6781\u661F\uFF0C\u4EE5\u6B63\u671D\u5915\u3002\u201D--\u300A\u5468\u793C\xB7\u8003\u5DE5\u8BB0\u300B\r\n
      \"\u7ACB\u516B\u5C3A\u4E4B\u8868\uFF0C\u590F\u81F3\u6677\u666F\u957F\u5C3A\u4E94\u5BF8\uFF0C\u51AC\u81F3\u6677\u666F\u957F\u4E08\u4E09\u5C3A\u4E00\u5BF8\u56DB\u5206\" 
      --\u300A\u6C49\u4E66\xB7\u5929\u6587\u5FD7\u300B\r\n \u201C\u6677\u5F71\u4E3A\u52FE\uFF0C\u52FE\u80A1\u5404\u4E58\uFF0C\u5E76\u800C\u5F00\u65B9\u9664\u4E4B\uFF0C\u5F97\u90AA\u81F3\u65E5\u3002\u201D--\u300A\u5468\u9AC0\u7B97\u7ECF\u300B\r\n
